{
  "name": "rubaxe",
  "version": "0.1.0",
  "description": "IDE rápida para Ruby: suporte Ruby inspirado no RubyMine, interface no estilo VS Code.",
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "build": "esbuild src/main/main.ts src/main/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist && esbuild src/renderer/app.ts --bundle --format=iife --outfile=dist/renderer.js",
    "typecheck": "tsc",
    "start": "npm run build && electron .",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@vscode/codicons": "0.0.45",
    "monaco-editor": "0.57.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "electron": "44.5.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
